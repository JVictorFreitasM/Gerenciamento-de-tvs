PORT=5001

# OS 12-B: autenticacao via IdP centralizado, substitui o login por senha proprio do TV Signage.
# idpUrl: chamado de dentro do container do backend (server-to-server). Se o IdP tambem rodar
# em Docker no host, use host.docker.internal; se rodar nativamente, ajuste conforme a rede.
IDP_URL=http://host.docker.internal:3000
# authorizeUrl: usado so pra montar os redirects que vao pro navegador do usuario - so precisa
# divergir de IDP_URL quando backend e navegador nao enxergam o IdP pelo mesmo hostname/porta.
IDP_AUTHORIZE_URL=http://localhost:3000
# OS 17: menu central do IdP (OS 13), usado no link "Voltar aos sistemas" das telas de erro.
# Sem definir, cai em `${IDP_URL}/home`.
IDP_HOME_URL=http://localhost:3000/home
IDP_CLIENT_ID=change-me
IDP_CLIENT_SECRET=change-me
# Deve bater exatamente com o redirectUri cadastrado no painel do IdP pro TV Signage (OS 12-A).
# O callback roda no BACKEND (esta porta), mesmo com a UI sendo uma SPA em outra origem.
IDP_REDIRECT_URI=http://localhost:5001/auth/callback
# OS 12-C: origem da SPA (frontend/, Vite em dev / nginx em Docker) - usada como destino
# pos-login/pos-logout (o callback roda no backend, mas quem o usuario deve ver e a UI) e
# como origem permitida no CORS (ver CORS_ORIGINS abaixo).
FRONTEND_URL=http://localhost:5002
# Opcional - lista de origens extras permitidas no CORS, separadas por virgula. Sem definir,
# cai em FRONTEND_URL sozinho.
# CORS_ORIGINS=http://localhost:5002

SESSION_SECRET=change-me-in-production
# false em dev (sem HTTPS local) - mudar para true quando houver certificado.
COOKIE_SECURE=false

REDIS_URL=redis://redis:6379
