<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Painel de Controle — TVs</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #111;
            color: white;
            padding: 40px;
        }

        .header-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-bottom: 1px solid #333;
            padding-bottom: 20px;
        }

        h1 {
            margin: 0;
        }

        .btn-logout {
            background: #dc3545;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: bold;
            transition: background 0.2s;
        }

        .btn-logout:hover {
            background: #bd2130;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .card {
            background: #222;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #333;
            box-sizing: border-box;
        }

        .card h2 {
            margin-top: 0;
            color: #007bff;
            border-bottom: 1px solid #333;
            padding-bottom: 10px;
        }

        .btn-action {
            display: block;
            text-align: center;
            text-decoration: none;
            padding: 12px;
            border-radius: 6px;
            font-weight: bold;
            margin-top: 12px;
            transition: opacity 0.2s;
        }

        .btn-action:hover {
            opacity: 0.9;
        }

        .btn-watch {
            background: #28a745;
            color: white;
        }

        .btn-change {
            background: #444;
            color: white;
        }
    </style>
</head>
<body>

<div class="header-area">
    <h1>Bem-vindo, <%= user.username %>!</h1>
    <a href="/logout" class="btn-logout">Sair do Sistema</a>
</div>

<div class="grid">

    <% setores.forEach(setor => { %>

        <div class="card">

            <h2>
                <%= setor.toUpperCase() %>
            </h2>

            <a href="/tv/<%= setor %>" target="_blank" class="btn-action btn-watch">
                📺 Assistir Transmissão
            </a>

            <a href="/upload/<%= setor %>" class="btn-action btn-change">
                🔄 Trocar Vídeo da TV
            </a>

        </div>

    <% }) %>

</div>

</body>
</html>