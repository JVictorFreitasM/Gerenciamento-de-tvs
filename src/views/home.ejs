<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>TV Signage</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {

            margin: 0;
            padding: 40px;

            background: #111;
            color: white;

            font-family: Arial;
        }

        .topbar {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 40px;
        }

        h1 {

            margin: 0;

        }

        .admin-btn {

            background: #2563eb;

            color: white;

            padding: 12px 20px;

            border-radius: 8px;

            text-decoration: none;

            font-weight: bold;

            transition: 0.2s;
        }

        .admin-btn:hover {

            background: #1d4ed8;
        }

        .grid {

            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(250px, 1fr));

            gap: 20px;
        }

        .card {

            background: #1e1e1e;

            border-radius: 12px;

            padding: 30px;

            transition: 0.2s;
        }

        .card:hover {

            transform: scale(1.03);

            background: #2b2b2b;
        }

        .card a {

            color: white;

            text-decoration: none;

            font-size: 24px;

            display: block;
        }

    </style>

</head>

<body>

    <div class="topbar">

        <h1>TV Signage</h1>

        <a
            href="/dashboard"
            class="admin-btn"
        >
            Painel Administrativo
        </a>

    </div>

    <div class="grid">

        <% setores.forEach(setor => { %>

            <div class="card">

                <a href="/tv/<%= setor.nome %>">

                    <%= setor.nome %>

                </a>

            </div>

        <% }) %>

    </div>

</body>

</html>