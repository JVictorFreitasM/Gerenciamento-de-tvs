<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Playlist - <%= setor.nome %>
    </title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0f172a;
            font-family: Arial, sans-serif;
            color: white;
            min-height: 100vh;
            padding: 30px;
        }

        .container {
            max-width: 1500px;
            margin: 0 auto;
        }

        /* =========================
           HEADER
        ========================= */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 32px;
        }

        .header span {
            color: #60a5fa;
        }

        .back-button {
            background: #1e293b;
            color: white;
            padding: 12px 18px;
            border-radius: 8px;
            text-decoration: none;
            transition: 0.2s;
        }

        .back-button:hover {
            background: #334155;
        }

        /* =========================
           CARD
        ========================= */

        .card {
            background: #111827;
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
        }

        /* =========================
           TOP ACTIONS
        ========================= */

        .top-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 25px;
        }

        /* =========================
           UPLOAD
        ========================= */

        .upload-form {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        .upload-form input[type="file"] {
            background: #1e293b;
            color: white;
            border: 1px solid #334155;
            padding: 10px;
            border-radius: 8px;
            cursor: pointer;
        }

        .upload-button,
        .delete-selected-button {
            border: none;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        .upload-button {
            background: #2563eb;
        }

        .upload-button:hover {
            background: #1d4ed8;
        }

        /* =========================
           DELETE SELECTED
        ========================= */

        .delete-selected-button {
            background: #dc2626;
        }

        .delete-selected-button:hover {
            background: #b91c1c;
        }

        .delete-selected-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* =========================
           TABLE
        ========================= */

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        thead {
            background: #1e293b;
        }

        th,
        td {
            padding: 16px;
            text-align: left;
            border-top: 1px solid #1e293b;
            vertical-align: middle;
        }

        th {
            color: #93c5fd;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        tbody tr {
            transition:
                transform 0.25s ease,
                opacity 0.25s ease,
                background 0.2s ease;

            cursor: grab;
            position: relative;
        }

        tbody tr:hover {
            background: rgba(255,255,255,0.03);
        }

        tbody tr.selected {
            background: rgba(37,99,235,0.18);
        }

        tbody tr.dragging {
            opacity: 0.4;
            transform: scale(0.98);
            background: rgba(37,99,235,0.15);
        }

        tbody tr.drag-over {
            border-top: 2px solid #60a5fa;
        }

        /* =========================
           COLUMNS
        ========================= */

        .checkbox-column {
            width: 60px;
        }

        .order-column {
            width: 90px;
        }

        .type-column {
            width: 130px;
        }

        .duration-column {
            width: 140px;
        }

        .preview-column {
            width: 120px;
        }

        .actions-column {
            width: 180px;
        }

        /* =========================
           CHECKBOX
        ========================= */

        .select-checkbox,
        #select-all {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        /* =========================
           MEDIA NAME
        ========================= */

        .media-name {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            max-width: 100%;
        }

        /* =========================
           BADGES
        ========================= */

        .badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-video {
            background: rgba(37,99,235,0.2);
            color: #60a5fa;
        }

        .badge-image {
            background: rgba(16,185,129,0.2);
            color: #34d399;
        }

        /* =========================
           DURATION
        ========================= */

        .duration-input {
            width: 80px;
            padding: 8px 10px;
            border-radius: 8px;
            border: 1px solid #334155;
            background: #1e293b;
            color: white;
            outline: none;
        }

        .duration-input:focus {
            border-color: #60a5fa;
        }

        .duration-disabled {
            color: #64748b;
            font-size: 13px;
        }

        /* =========================
           ACTIONS
        ========================= */

        .actions {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: nowrap;
        }

        .action-button {
            width: 40px;
            min-width: 40px;
            height: 40px;

            border: none;
            border-radius: 8px;

            cursor: pointer;

            font-size: 18px;
            font-weight: bold;

            transition: 0.2s;

            color: white;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-up {
            background: #2563eb;
        }

        .btn-up:hover {
            background: #1d4ed8;
        }

        .btn-down {
            background: #7c3aed;
        }

        .btn-down:hover {
            background: #6d28d9;
        }

        .btn-remove {
            background: #dc2626;
        }

        .btn-remove:hover {
            background: #b91c1c;
        }

        /* =========================
           PREVIEW
        ========================= */

        .preview-trigger {
            position: relative;
        }

        .preview-card {
            position: fixed;

            width: 280px;
            height: 160px;

            border-radius: 14px;
            overflow: hidden;

            background: #0f172a;

            border: 1px solid rgba(255,255,255,0.08);

            box-shadow:
                0 15px 35px rgba(0,0,0,0.45);

            opacity: 0;
            pointer-events: none;

            transition:
                opacity 0.2s ease,
                transform 0.2s ease;

            transform: scale(0.95);

            z-index: 9999;
        }

        .preview-card img,
        .preview-card video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .preview-trigger:hover .preview-card {
            opacity: 1;
            transform: scale(1);
        }

        /* =========================
           EMPTY
        ========================= */

        .empty {
            text-align: center;
            padding: 40px;
            color: #94a3b8;
        }

        /* =========================
           MOVE ANIMATION
        ========================= */

        .moving-up {
            animation: moveUpAnimation 0.35s ease;
        }

        .moving-down {
            animation: moveDownAnimation 0.35s ease;
        }

        @keyframes moveUpAnimation {

            0% {
                transform: translateY(0);
                opacity: 1;
            }

            50% {
                transform: translateY(-12px);
                opacity: 0.5;
            }

            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes moveDownAnimation {

            0% {
                transform: translateY(0);
                opacity: 1;
            }

            50% {
                transform: translateY(12px);
                opacity: 0.5;
            }

            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* =========================
           UPLOAD LOCK
        ========================= */

        #upload-overlay {
            position: fixed;
            inset: 0;

            background: rgba(15,23,42,0.85);

            display: none;
            justify-content: center;
            align-items: center;

            z-index: 99999;

            backdrop-filter: blur(6px);
        }

        .upload-loading {
            background: #111827;
            padding: 40px;
            border-radius: 16px;
            text-align: center;

            box-shadow:
                0 15px 35px rgba(0,0,0,0.45);
        }

        .upload-loading p {
            margin-top: 20px;
            font-size: 18px;
        }

        .spinner {
            width: 60px;
            height: 60px;

            border-radius: 50%;

            border: 5px solid rgba(255,255,255,0.1);
            border-top: 5px solid #60a5fa;

            animation: spin 1s linear infinite;

            margin: 0 auto;
        }

        @keyframes spin {

            to {
                transform: rotate(360deg);
            }
        }

    </style>

</head>

<body>

    <!-- OVERLAY -->
    <div id="upload-overlay">

        <div class="upload-loading">

            <div class="spinner"></div>

            <p>
                Enviando mídia...
            </p>

        </div>

    </div>

    <div class="container">

        <!-- HEADER -->
        <div class="header">

            <h1>
                Playlist
                <span>
                    <%= setor.nome %>
                </span>
            </h1>

            <a
                href="/dashboard"
                class="back-button"
            >
                Voltar
            </a>

        </div>

        <!-- CARD -->
        <div class="card">

            <!-- TOP ACTIONS -->
            <div class="top-actions">

                <!-- UPLOAD -->
                <form
                    id="upload-form"
                    class="upload-form"
                    action="/upload/<%= setor.nome %>"
                    method="POST"
                    enctype="multipart/form-data"
                >

                    <input
                        type="file"
                        name="media"
                        accept=".mp4,image/*"
                        multiple
                        required
                    >

                    <button
                        type="submit"
                        class="upload-button"
                    >
                        Upload
                    </button>

                </form>

                <!-- DELETE SELECTED -->
                <button
                    id="delete-selected-button"
                    class="delete-selected-button"
                    disabled
                >
                    Excluir Selecionados
                </button>

            </div>

            <!-- TABLE -->
            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th class="checkbox-column">

                                <input
                                    type="checkbox"
                                    id="select-all"
                                >

                            </th>

                            <th class="order-column">
                                Ordem
                            </th>

                            <th>
                                Nome
                            </th>

                            <th class="type-column">
                                Tipo
                            </th>

                            <th class="duration-column">
                                Duração
                            </th>

                            <th class="preview-column">
                                Preview
                            </th>

                            <th class="actions-column">
                                Ações
                            </th>

                        </tr>

                    </thead>

                    <tbody id="playlist-body">

                        <% if (medias.length === 0) { %>

                            <tr>

                                <td
                                    colspan="7"
                                    class="empty"
                                >
                                    Nenhuma mídia na playlist.
                                </td>

                            </tr>

                        <% } %>

                        <% medias.forEach(item => { %>

                            <tr
                                draggable="true"
                                data-id="<%= item.id %>"
                                class="media-row"
                            >

                                <!-- CHECKBOX -->
                                <td>

                                    <input
                                        type="checkbox"
                                        class="select-checkbox"
                                        data-media-id="<%= item.media.id %>"
                                    >

                                </td>

                                <!-- ORDEM -->
                                <td>

                                    <strong>
                                        <%= item.ordem %>
                                    </strong>

                                </td>

                                <!-- NOME -->
                                <td
                                    class="media-name"
                                    title="<%= item.media.nome %>"
                                >
                                    <%= item.media.nome %>
                                </td>

                                <!-- TIPO -->
                                <td>

                                    <% if (item.media.tipo === "VIDEO") { %>

                                        <span class="badge badge-video">
                                            VIDEO
                                        </span>

                                    <% } else { %>

                                        <span class="badge badge-image">
                                            IMAGEM
                                        </span>

                                    <% } %>

                                </td>

                                <!-- DURATION -->
                                <td>

                                    <% if (item.media.tipo === "IMAGEM") { %>

                                        <input
                                            type="number"
                                            min="1"
                                            class="duration-input"
                                            value="<%= item.media.duracao || 10 %>"
                                            data-media-id="<%= item.media.id %>"
                                        >

                                    <% } else { %>

                                        <span class="duration-disabled">
                                            Automático
                                        </span>

                                    <% } %>

                                </td>

                                <!-- PREVIEW -->
                                <td class="preview-trigger">

                                    Hover

                                    <div class="preview-card">

                                        <% if (item.media.tipo === "VIDEO") { %>

                                            <video
                                                src="/videos/<%= setor.nome %>/<%= item.media.filename %>"
                                                muted
                                                preload="metadata"
                                            ></video>

                                        <% } else { %>

                                            <img
                                                src="/videos/<%= setor.nome %>/<%= item.media.filename %>"
                                                alt="Preview"
                                            >

                                        <% } %>

                                    </div>

                                </td>

                                <!-- ACTIONS -->
                                <td>

                                    <div class="actions">

                                        <!-- UP -->
                                        <form
                                            method="POST"
                                            action="/playlist/move-up/<%= item.id %>"
                                            class="move-up-form"
                                        >

                                            <button
                                                type="submit"
                                                class="action-button btn-up"
                                            >
                                                ↑
                                            </button>

                                        </form>

                                        <!-- DOWN -->
                                        <form
                                            method="POST"
                                            action="/playlist/move-down/<%= item.id %>"
                                            class="move-down-form"
                                        >

                                            <button
                                                type="submit"
                                                class="action-button btn-down"
                                            >
                                                ↓
                                            </button>

                                        </form>

                                        <!-- REMOVE -->
                                        <button
                                            type="button"
                                            class="action-button btn-remove"
                                            onclick="deleteMedia(this, <%= item.media.id %>)"
                                        >
                                            ×
                                        </button>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <script>

        // =========================
        // ELEMENTS
        // =========================

        const selectAll =
            document.getElementById("select-all");

        const deleteSelectedButton =
            document.getElementById("delete-selected-button");

        const uploadForm =
            document.getElementById("upload-form");

        const overlay =
            document.getElementById("upload-overlay");

        const tbody =
            document.getElementById("playlist-body");

        const checkboxes =
            document.querySelectorAll(".select-checkbox");

        let draggedRow = null;

        // =========================
        // CHECKBOXES
        // =========================

        function updateSelectedState() {

            const checked =
                document.querySelectorAll(
                    ".select-checkbox:checked"
                );

            deleteSelectedButton.disabled =
                checked.length === 0;

            document
                .querySelectorAll(".media-row")
                .forEach(row => {

                    const checkbox =
                        row.querySelector(
                            ".select-checkbox"
                        );

                    row.classList.toggle(
                        "selected",
                        checkbox.checked
                    );

                });

        }

        selectAll?.addEventListener(
            "change",
            () => {

                checkboxes.forEach(checkbox => {

                    checkbox.checked =
                        selectAll.checked;

                });

                updateSelectedState();

            }
        );

        checkboxes.forEach(checkbox => {

            checkbox.addEventListener(
                "change",
                updateSelectedState
            );

        });

        // =========================
        // DELETE INDIVIDUAL
        // =========================

        async function deleteMedia(button, id) {

            const confirmed = confirm(
                "Deseja excluir esta mídia?"
            );

            if (!confirmed) return;

            try {

                const response = await fetch(
                    `/media/${id}`,
                    {
                        method: "DELETE"
                    }
                );

                const data =
                    await response.json();

                if (!data.success) {

                    alert("Erro ao excluir");

                    return;

                }

                button.closest("tr").remove();

                updateSelectedState();

            } catch (error) {

                console.error(error);

                alert("Erro ao excluir mídia");

            }

        }

        // =========================
        // DELETE SELECTED
        // =========================

        deleteSelectedButton.addEventListener(
            "click",
            async () => {

                const checked =
                    document.querySelectorAll(
                        ".select-checkbox:checked"
                    );

                if (checked.length === 0) {

                    alert(
                        "Nenhuma mídia selecionada"
                    );

                    return;

                }

                const confirmed = confirm(
                    `Deseja excluir ${checked.length} mídia(s)?`
                );

                if (!confirmed) return;

                const ids = Array.from(checked).map(

                    checkbox =>

                        checkbox.dataset.mediaId

                );

                try {

                    const response = await fetch(
                        "/media/bulk",
                        {
                            method: "DELETE",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                ids
                            })
                        }
                    );

                    const data =
                        await response.json();

                    if (!data.success) {

                        alert("Erro ao excluir");

                        return;

                    }

                    checked.forEach(checkbox => {

                        checkbox
                            .closest("tr")
                            .remove();

                    });

                    updateSelectedState();

                } catch (error) {

                    console.error(error);

                    alert(
                        "Erro ao excluir mídias"
                    );

                }

            }
        );

        // =========================
        // IMAGE DURATION
        // =========================

        document
            .querySelectorAll(".duration-input")
            .forEach(input => {

                input.addEventListener(
                    "change",
                    async () => {

                        const duration =
                            Number(input.value);

                        const mediaId =
                            input.dataset.mediaId;

                        if (duration < 1) {

                            alert(
                                "A duração mínima é 1 segundo."
                            );

                            input.value = 10;

                            return;

                        }

                        try {

                            await fetch(
                                `/media/${mediaId}/duration`,
                                {
                                    method: "PUT",

                                    headers: {
                                        "Content-Type":
                                            "application/json"
                                    },

                                    body: JSON.stringify({
                                        duracao: duration
                                    })
                                }
                            );

                        } catch (error) {

                            console.error(error);

                            alert(
                                "Erro ao salvar duração."
                            );

                        }

                    }
                );

            });

        // =========================
        // VIDEO PREVIEW
        // =========================

        document
    .querySelectorAll(".preview-trigger")
    .forEach(trigger => {

        const card =
            trigger.querySelector(".preview-card");

        trigger.addEventListener(
            "mousemove",
            event => {

                card.style.left =
                    (event.clientX + 20) + "px";

                card.style.top =
                    (event.clientY - 80) + "px";

            }
        );

    });

        // =========================
        // MOVE UP
        // =========================

        document
            .querySelectorAll(".move-up-form")
            .forEach(form => {

                form.addEventListener(
                    "submit",
                    event => {

                        event.preventDefault();

                        const row =
                            form.closest("tr");

                        row.classList.add(
                            "moving-up"
                        );

                        setTimeout(() => {
                            form.submit();
                        }, 300);

                    }
                );

            });

        // =========================
        // MOVE DOWN
        // =========================

        document
            .querySelectorAll(".move-down-form")
            .forEach(form => {

                form.addEventListener(
                    "submit",
                    event => {

                        event.preventDefault();

                        const row =
                            form.closest("tr");

                        row.classList.add(
                            "moving-down"
                        );

                        setTimeout(() => {
                            form.submit();
                        }, 300);

                    }
                );

            });

        // =========================
        // DRAG AND DROP
        // =========================

        document
            .querySelectorAll("#playlist-body tr")
            .forEach(row => {

                row.addEventListener(
                    "dragstart",
                    () => {

                        draggedRow = row;

                        row.classList.add(
                            "dragging"
                        );

                    }
                );

                row.addEventListener(
                    "dragend",
                    () => {

                        row.classList.remove(
                            "dragging"
                        );

                    }
                );

                row.addEventListener(
                    "dragover",
                    event => {

                        event.preventDefault();

                        row.classList.add(
                            "drag-over"
                        );

                    }
                );

                row.addEventListener(
                    "dragleave",
                    () => {

                        row.classList.remove(
                            "drag-over"
                        );

                    }
                );

                row.addEventListener(
                    "drop",
                    async event => {

                        event.preventDefault();

                        row.classList.remove(
                            "drag-over"
                        );

                        if (
                            draggedRow &&
                            draggedRow !== row
                        ) {

                            tbody.insertBefore(
                                draggedRow,
                                row
                            );

                            const orderedIds =
                                Array.from(
                                    tbody.querySelectorAll("tr")
                                ).map(tr => tr.dataset.id);

                            await fetch(
                                "/playlist/reorder",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json"
                                    },

                                    body: JSON.stringify({
                                        orderedIds
                                    })
                                }
                            );

                            location.reload();

                        }

                    }
                );

            });

        // =========================
        // UPLOAD LOCK
        // =========================

        uploadForm.addEventListener(
            "submit",
            () => {

                overlay.style.display =
                    "flex";

                document
                    .querySelectorAll("button")
                    .forEach(button => {

                        button.disabled = true;

                    });

                document
                    .querySelectorAll(
                        "#playlist-body tr"
                    )
                    .forEach(row => {

                        row.draggable = false;

                    });

            }
        );

    </script>

</body>

</html>