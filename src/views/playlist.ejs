<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Playlist - <%= setor.nome %>
    </title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            background: #0f172a;

            font-family: Arial, sans-serif;

            color: white;

            min-height: 100vh;

            padding: 30px;
        }

        .container {

            max-width: 1400px;

            margin: 0 auto;
        }

        /* =========================
           HEADER
        ========================= */

        .header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 30px;
        }

        .header h1 {

            font-size: 32px;

            color: white;
        }

        .header span {

            color: #60a5fa;
        }

        .back-button {

            background: #1e293b;

            color: white;

            padding: 12px 18px;

            border-radius: 8px;

            text-decoration: none;

            transition: 0.2s;
        }

        .back-button:hover {

            background: #334155;
        }

        /* =========================
           CARD
        ========================= */

        .card {

            background: #111827;

            border-radius: 14px;

            padding: 25px;

            box-shadow:
                0 0 20px rgba(0,0,0,0.3);
        }

        /* =========================
           UPLOAD
        ========================= */

        .upload-form {

            display: flex;

            gap: 15px;

            align-items: center;

            margin-bottom: 30px;

            flex-wrap: wrap;
        }

        .upload-form input[type="file"] {

            background: #1e293b;

            color: white;

            border: 1px solid #334155;

            padding: 10px;

            border-radius: 8px;

            cursor: pointer;
        }

        .upload-button {

            background: #2563eb;

            border: none;

            color: white;

            padding: 12px 20px;

            border-radius: 8px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.2s;
        }

        .upload-button:hover {

            background: #1d4ed8;
        }

        /* =========================
           TABLE
        ========================= */

        .table-wrapper {

            overflow-x: auto;
        }

        table {

            width: 100%;

            border-collapse: collapse;
        }

        thead {

            background: #1e293b;
        }

        th {

            padding: 16px;

            text-align: left;

            color: #93c5fd;

            font-size: 14px;

            text-transform: uppercase;

            letter-spacing: 1px;
        }

        td {

            padding: 18px 16px;

            border-top: 1px solid #1e293b;

            vertical-align: middle;
        }

        tbody tr {

            transition:
                transform 0.25s ease,
                opacity 0.25s ease,
                background 0.2s ease;

            cursor: grab;

            position: relative;
        }

        tbody tr:hover {

            background:
                rgba(255,255,255,0.03);
        }

        tbody tr.dragging {

            opacity: 0.4;

            transform: scale(0.98);

            background:
                rgba(37,99,235,0.15);
        }

        tbody tr.drag-over {

            border-top:
                2px solid #60a5fa;
        }

        /* =========================
           BADGES
        ========================= */

        .badge {

            display: inline-block;

            padding: 6px 12px;

            border-radius: 999px;

            font-size: 12px;

            font-weight: bold;
        }

        .badge-video {

            background:
                rgba(37,99,235,0.2);

            color: #60a5fa;
        }

        .badge-image {

            background:
                rgba(16,185,129,0.2);

            color: #34d399;
        }

        /* =========================
           ACTIONS
        ========================= */

        .actions {

            display: flex;

            gap: 10px;

            align-items: center;
        }

        .action-button {

            width: 40px;

            height: 40px;

            border: none;

            border-radius: 8px;

            cursor: pointer;

            font-size: 18px;

            font-weight: bold;

            transition: 0.2s;

            color: white;
        }

        .btn-up {

            background: #2563eb;
        }

        .btn-up:hover {

            background: #1d4ed8;
        }

        .btn-down {

            background: #7c3aed;
        }

        .btn-down:hover {

            background: #6d28d9;
        }

        .btn-remove {

            background: #dc2626;
        }

        .btn-remove:hover {

            background: #b91c1c;
        }

        /* =========================
           PREVIEW
        ========================= */

        .preview-trigger {

            position: relative;
        }

        .preview-card {

            position: absolute;

            top: 50%;

            left: 110%;

            transform:
                translateY(-50%)
                scale(0.95);

            width: 280px;

            height: 160px;

            border-radius: 14px;

            overflow: hidden;

            background: #0f172a;

            border:
                1px solid rgba(255,255,255,0.08);

            box-shadow:
                0 15px 35px rgba(0,0,0,0.45);

            opacity: 0;

            pointer-events: none;

            transition:
                opacity 0.2s ease,
                transform 0.2s ease;

            z-index: 999;
        }

        .preview-card img,
        .preview-card video {

            width: 100%;

            height: 100%;

            object-fit: cover;

            display: block;
        }

        .preview-trigger:hover .preview-card {

            opacity: 1;

            transform:
                translateY(-50%)
                scale(1);
        }

        /* =========================
           EMPTY
        ========================= */

        .empty {

            text-align: center;

            padding: 40px;

            color: #94a3b8;
        }

        /* =========================
           MOVE ANIMATION
        ========================= */

        .moving-up {

            animation:
                moveUpAnimation 0.35s ease;
        }

        .moving-down {

            animation:
                moveDownAnimation 0.35s ease;
        }

        @keyframes moveUpAnimation {

            0% {

                transform:
                    translateY(0);

                opacity: 1;
            }

            50% {

                transform:
                    translateY(-12px);

                opacity: 0.5;
            }

            100% {

                transform:
                    translateY(0);

                opacity: 1;
            }
        }

        @keyframes moveDownAnimation {

            0% {

                transform:
                    translateY(0);

                opacity: 1;
            }

            50% {

                transform:
                    translateY(12px);

                opacity: 0.5;
            }

            100% {

                transform:
                    translateY(0);

                opacity: 1;
            }
        }

    </style>

</head>

<body>

    <div class="container">

        <!-- HEADER -->
        <div class="header">

            <h1>

                Playlist
                <span>
                    <%= setor.nome %>
                </span>

            </h1>

            <a
                href="/dashboard"
                class="back-button"
            >

                Voltar

            </a>

        </div>

        <!-- CARD -->
        <div class="card">

            <!-- UPLOAD -->
            <form

                class="upload-form"

                action="/upload/<%= setor.nome %>"

                method="POST"

                enctype="multipart/form-data"
            >

                <input
                    type="file"
                    name="media"
                    accept=".mp4,image/*"
                    required
                >

                <button
                    type="submit"
                    class="upload-button"
                >

                    Upload

                </button>

            </form>

            <!-- TABELA -->
            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>Ordem</th>

                            <th>Nome</th>

                            <th>Tipo</th>

                            <th>Preview</th>

                            <th>Ações</th>

                        </tr>

                    </thead>

                    <tbody id="playlist-body">

                        <% if (medias.length === 0) { %>

                            <tr>

                                <td
                                    colspan="5"
                                    class="empty"
                                >

                                    Nenhuma mídia na playlist.

                                </td>

                            </tr>

                        <% } %>

                        <% medias.forEach(item => { %>

                            <tr
                                draggable="true"
                                data-id="<%= item.id %>"
                                class="media-row"
                            >

                                <!-- ORDEM -->
                                <td>

                                    <strong>
                                        <%= item.ordem %>
                                    </strong>

                                </td>

                                <!-- NOME -->
                                <td>

                                    <%= item.media.nome %>

                                </td>

                                <!-- TIPO -->
                                <td>

                                    <% if (item.media.tipo === "VIDEO") { %>

                                        <span
                                            class="badge badge-video"
                                        >

                                            VIDEO

                                        </span>

                                    <% } else { %>

                                        <span
                                            class="badge badge-image"
                                        >

                                            IMAGEM

                                        </span>

                                    <% } %>

                                </td>

                                <!-- PREVIEW -->
                                <td class="preview-trigger">

                                    Hover

                                    <div class="preview-card">

                                        <% if (item.media.tipo === "VIDEO") { %>

                                            <video
                                                src="/videos/<%= setor.nome %>/<%= item.media.filename %>"
                                                muted
                                                autoplay
                                                loop
                                                playsinline
                                            ></video>

                                        <% } else { %>

                                            <img
                                                src="/videos/<%= setor.nome %>/<%= item.media.filename %>"
                                                alt="Preview"
                                            >

                                        <% } %>

                                    </div>

                                </td>

                                <!-- AÇÕES -->
                                <td>

                                    <div class="actions">

                                        <!-- UP -->
                                        <form
                                            method="POST"
                                            action="/playlist/move-up/<%= item.id %>"
                                            class="move-up-form"
                                        >

                                            <button
                                                type="submit"
                                                class="action-button btn-up"
                                            >

                                                ↑

                                            </button>

                                        </form>

                                        <!-- DOWN -->
                                        <form
                                            method="POST"
                                            action="/playlist/move-down/<%= item.id %>"
                                            class="move-down-form"
                                        >

                                            <button
                                                type="submit"
                                                class="action-button btn-down"
                                            >

                                                ↓

                                            </button>

                                        </form>

                                        <!-- REMOVE -->
                                        <button
                                            type="button"
                                            class="action-button btn-remove"
                                            onclick="deleteMedia(this, <%= item.media.id %>)"
                                        >

                                            ×

                                        </button>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <script>

        // =========================
        // DELETE
        // =========================

        async function deleteMedia(button, id) {

            const confirmed = confirm(
                "Deseja excluir esta mídia?"
            );

            if (!confirmed) return;

            try {

                const response = await fetch(

                    `/media/${id}`,

                    {
                        method: "DELETE"
                    }
                );

                const data = await response.json();

                if (!data.success) {

                    alert("Erro ao excluir");

                    return;

                }

                const row =
                    button.closest("tr");

                row.remove();

            } catch (error) {

                console.error(error);

                alert("Erro ao excluir mídia");

            }

        }

        // =========================
        // MOVE UP
        // =========================

        document
            .querySelectorAll(
                ".move-up-form"
            )
            .forEach(form => {

                form.addEventListener(
                    "submit",
                    function (event) {

                        event.preventDefault();

                        const row =
                            form.closest("tr");

                        row.classList.add(
                            "moving-up"
                        );

                        setTimeout(() => {

                            form.submit();

                        }, 300);

                    }
                );

            });

        // =========================
        // MOVE DOWN
        // =========================

        document
            .querySelectorAll(
                ".move-down-form"
            )
            .forEach(form => {

                form.addEventListener(
                    "submit",
                    function (event) {

                        event.preventDefault();

                        const row =
                            form.closest("tr");

                        row.classList.add(
                            "moving-down"
                        );

                        setTimeout(() => {

                            form.submit();

                        }, 300);

                    }
                );

            });

        // =========================
        // DRAG AND DROP
        // =========================

        const tbody =
            document.getElementById(
                "playlist-body"
            );

        let draggedRow = null;

        document
            .querySelectorAll(
                "#playlist-body tr"
            )
            .forEach(row => {

                row.addEventListener(
                    "dragstart",
                    () => {

                        draggedRow = row;

                        row.classList.add(
                            "dragging"
                        );

                    }
                );

                row.addEventListener(
                    "dragend",
                    () => {

                        row.classList.remove(
                            "dragging"
                        );

                    }
                );

                row.addEventListener(
                    "dragover",
                    event => {

                        event.preventDefault();

                        row.classList.add(
                            "drag-over"
                        );

                    }
                );

                row.addEventListener(
                    "dragleave",
                    () => {

                        row.classList.remove(
                            "drag-over"
                        );

                    }
                );

                row.addEventListener(
                    "drop",
                    async event => {

                        event.preventDefault();

                        row.classList.remove(
                            "drag-over"
                        );

                        if (
                            draggedRow &&
                            draggedRow !== row
                        ) {

                            tbody.insertBefore(
                                draggedRow,
                                row
                            );

                            const orderedIds =
                                Array.from(

                                    tbody.querySelectorAll(
                                        "tr"
                                    )

                                ).map(tr =>

                                    tr.dataset.id

                                );

                            const response = await fetch(
                                "/playlist/reorder",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type": "application/json"
                                    },

                                    body: JSON.stringify({
                                        orderedIds
                                    })
                                }
                            );

                            const data = await response.json();

                            console.log(data);

                            location.reload();

                        }

                    }
                );

            });

    </script>

</body>

</html>