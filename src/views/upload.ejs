<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Upload - <%= setor %></title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #111;
            color: white;
            padding: 40px;
        }

        form {
            background: #222;
            padding: 30px;
            border-radius: 12px;
            max-width: 400px;
        }

        
        input,
        button {
            box-sizing: border-box;
            width: 100%;
            margin-top: 15px;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #444;
        }

        input[type="file"] {
            background: #333;
            color: #fff;
            cursor: pointer;
        }

        button {
            background: #007bff;
            color: white;
            border: none;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }

        button:hover {
            background: #0056b3;
        }
    </style>
</head>
<body>

<h1>
    Upload de Vídeo — Setor: <%= setor %>
</h1>

<form
    action="/upload/<%= setor %>"
    method="POST"
    enctype="multipart/form-data"
>

    <input
        type="hidden"
        name="setor"
        value="<%= setor %>"
    >

    <input
        type="file"
        name="media"
        accept="video/mp4"
        required
    >

    <button type="submit">
        Enviar vídeo/imagem
    </button>

</form>

</body>
</html>