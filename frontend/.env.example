# OS 12-C: origem absoluta do backend, usada pelo proxy do Vite e para montar as
# URLs de /auth/login e /auth/logout (que rodam no backend, fora do proxy).
VITE_BACKEND_URL=http://localhost:5001
# Origem do proprio frontend, usada para montar o returnTo de volta ao painel
# depois do login/logout no IdP.
VITE_FRONTEND_URL=http://localhost:5002
# OS 17: menu central do IdP (OS 13), pro botao "Voltar aos sistemas" na sidebar.
VITE_IDP_HOME_URL=http://localhost:3000/home
